// C2 Beaconing Detection
// Purpose: Detect regular-interval DNS queries to a suspicious domain —
// a classic signature of malware "phoning home" to a command-and-control
// (C2) server on a fixed check-in schedule.

index=main host=kali source="*dns.log"
| rex field=_raw "^(?<ts>[^\t]+)\t(?<uid>[^\t]+)\t(?<src_ip>[^\t]+)\t(?<src_port>[^\t]+)\t(?<dest_ip>[^\t]+)\t(?<dest_port>[^\t]+)\t(?<proto>[^\t]+)\t(?<trans_id>[^\t]+)\t(?<rtt>[^\t]+)\t(?<query>[^\t]+)\t(?<qclass>[^\t]+)\t(?<qclass_name>[^\t]+)\t(?<qtype>[^\t]+)\t(?<qtype_name>[^\t]+)\t(?<rcode>[^\t]+)\t(?<rcode_name>[^\t]+)"
| search query="*suspicious-c2-domain*"
| sort ts
| streamstats current=f last(ts) as prev_ts
| eval gap_seconds=round(ts - prev_ts, 1)
| table _time, query, src_ip, rcode_name, gap_seconds
